{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajaysurya1221/dorian/blob/main/spec/warrant.schema.json",
  "title": "VWP Validity Warrant sidecar (.warrant)",
  "type": "object",
  "required": ["spec_version", "warrant"],
  "properties": {
    "spec_version": { "const": "0.1" },
    "warrant": {
      "type": "object",
      "required": ["id", "artifact", "produced_by", "read_set", "claims", "fold_policy", "sealed_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "artifact": {
          "type": "object",
          "required": ["uri", "content_hash"],
          "properties": {
            "uri": { "type": "string" },
            "content_hash": { "type": "string" },
            "git_ref": { "type": "string" }
          }
        },
        "produced_by": {
          "type": "object",
          "required": ["runner", "captured_at"],
          "properties": {
            "runner": { "enum": ["claude-code", "manual", "bench-synthetic"] },
            "run_ref": { "type": "string" },
            "model": { "type": "string" },
            "prompt_hash": { "type": "string" },
            "captured_at": { "type": "string" }
          }
        },
        "read_set": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "uri", "hash"],
            "properties": {
              "id": { "type": "string" },
              "uri": { "type": "string" },
              "selector": { "type": ["string", "null"], "pattern": "^L\\d+-\\d+$" },
              "hash": { "type": "string" },
              "version": { "type": ["string", "null"] },
              "scope": { "enum": ["project", "external", "unknown"] }
            }
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "text", "kind", "load_bearing", "checkers"],
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "kind": { "enum": ["fact", "reference", "behavior", "quantity", "decision"] },
              "anchor": {
                "type": ["object", "null"],
                "properties": {
                  "line_start": { "type": "integer" },
                  "line_end": { "type": "integer" },
                  "quote": { "type": "string" }
                }
              },
              "load_bearing": { "type": "boolean" },
              "supports": { "type": "array", "items": { "type": "string" } },
              "checkers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type", "program"],
                  "properties": {
                    "type": { "enum": ["C1", "C3", "C4", "C5"] },
                    "program": { "type": "string" },
                    "expect": { "type": "string" },
                    "watch": { "type": "array", "items": { "type": "string" } },
                    "timeout_s": { "type": "integer" }
                  }
                }
              }
            }
          }
        },
        "derives_from": { "type": "array", "items": { "type": "string" } },
        "fold_policy": {
          "type": "object",
          "properties": {
            "revoke_on": { "enum": ["load_bearing_broken", "any_broken"] },
            "degrade_on": { "enum": ["any_stale_or_broken", "any_broken"] }
          }
        },
        "sealed_at": { "type": "string" },
        "supersedes": { "type": ["string", "null"] }
      }
    }
  }
}
